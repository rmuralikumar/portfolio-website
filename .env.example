# ==============================================================================
# Gmail SMTP Configuration for Vercel Serverless Function & Nodemailer
# Add these variables to your Vercel Project Settings:
# Vercel Dashboard -> Project -> Settings -> Environment Variables
# ==============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=muralicodex@gmail.com
SMTP_PASSWORD=your_16_character_google_app_password
CONTACT_EMAIL=muralicodex@gmail.com

# ==============================================================================
# Cloudflare Turnstile CAPTCHA (Managed Mode)
# Create widget at https://dash.cloudflare.com/ -> Turnstile
# Authorized Domains: rmuralikumar.vercel.app, localhost, 127.0.0.1
# ==============================================================================
TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key


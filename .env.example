# ==============================================================================
# Copy this file to .env (local) and fill in real values. Never commit .env.
# On Vercel, add the same names under Project -> Settings -> Environment Variables
# (Production and Preview), then redeploy.
# ==============================================================================

# ------------------------------------------------------------------------------
# Gmail SMTP: used by the contact form API route (src/app/api/contact/route.ts)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=muralicodex@gmail.com
SMTP_PASSWORD=your_16_character_google_app_password
CONTACT_EMAIL=muralicodex@gmail.com

# ------------------------------------------------------------------------------
# Cloudflare Turnstile (Managed mode): https://dash.cloudflare.com/ -> Turnstile
# Widget hostnames: rmuralikumar.vercel.app, localhost
#
# TURNSTILE_SITE_KEY is public: it is embedded in the page when the site is built,
# so a new value needs a redeploy. TURNSTILE_SECRET_KEY stays on the server.
# ------------------------------------------------------------------------------
TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key

# Optional: extra custom domains (comma-separated) accepted by the server-side
# hostname check. Add the same hostnames in the Turnstile widget's Hostname Management.
ALLOWED_HOSTNAMES=
